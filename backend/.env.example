# Local API. Production uses the public URL of the Node server.
PORT=3777
NODE_ENV=development

# MySQL. On a host, use the database host from that panel, not your laptop.
DB_HOST=127.0.0.1
DB_USER=
DB_PASS=
DB_NAME=Evangadi_Forum_DB

# Long random string. Generate a new one for production. Do not reuse a sample.
JWT_SECRET=
JWT_EXPIRES_IN=1d

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=

RECOMMEND_THRESHOLD=0.75
RECOMMEND_K=5

RAG_UPLOAD_DIR=uploads/rag
RAG_MAX_UPLOAD_MB=5
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_MAX_CHUNKS_PER_DOC=1000
RAG_MAX_PDFS_PER_USER=20
RAG_MIN_TEXT_CHARS=50
RAG_SEARCH_THRESHOLD=0.75
RAG_SEARCH_K=10

# EmailJS. The private key stays on the server.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# One public site address, no trailing slash. Used in password-reset links.
FRONTEND_URL=http://localhost:5173
# Extra browser origins, comma-separated. Example: https://your-app.vercel.app
CORS_ORIGINS=

# Host name only, no https://. Must match the site people open.
WEBAUTHN_RP_ID=localhost
# Full address of that site, including https:// in production.
WEBAUTHN_ORIGIN=http://localhost:5173
